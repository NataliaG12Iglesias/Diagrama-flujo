            <h3>KPIs Calculados:</h3>
            <table>
                <thead>
                    <tr>
                        <th>Indicador</th>
                        <th>Fórmula</th>
                        <th>Objetivo</th>
                        <th>Alerta</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Rentabilidad Bruta</td>
                        <td>((Ingresos - Costos) / Ingresos) × 100</td>
                        <td>> 50%</td>
                        <td>< 50% = Rojo</td>
                    </tr>
                    <tr>
                        <td>Presupuesto Disponible</td>
                        <td>Presupuesto Total - Costos Reales</td>
                        <td>> 0</td>
                        <td>< 0 = Rojo</td>
                    </tr>
                    <tr>
                        <td>Desviación Horas</td>
                        <td>Horas Estimadas - Horas Reales</td>
                        <td>± 10%</td>
                        <td>> 10% = Amarillo</td>
                    </tr>
                    <tr>
                        <td>Días Restantes</td>
                        <td>Fecha Entrega - Fecha Actual</td>
                        <td>> 0</td>
                        <td>< 0 = Rojo (Overdue)</td>
                    </tr>
                    <tr>
                        <td>Capacidad Utilizada</td>
                        <td>(Horas Trabajadas / Horas Disponibles) × 100</td>
                        <td>80-90%</td>
                        <td>> 100% = Rojo</td>
                    </tr>
                </tbody>
            </table>
            
